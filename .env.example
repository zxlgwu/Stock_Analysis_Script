# Copy to .env and fill in. Never commit the real .env file.
# Prices and charts do not need a key. News, filings, and email do.

# FINNHUB_API_KEY=
# CURSOR_API_KEY=cursor_...   # Dashboard → Integrations. Lets the app run a Cursor model.
# SEC_USER_AGENT=stock-agent/0.1 (your name; you@example.com)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
